# Copie este arquivo para ".env" (mesma pasta) e preencha os valores reais.
# O ".env" nunca deve ser commitado (já está no .gitignore).

# Supabase > Project Settings > Data API (SUPABASE_URL) e API Keys (service_role)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_KEY=sua-chave-service-role-aqui

# Hugging Face - token grátis para a Inference API (embeddings semânticos).
# Como gerar: huggingface.co > crie uma conta > Settings > Access Tokens >
# "Create new token" > tipo "Fine-grained" > marque a permissão
# "Make calls to Inference Providers" (sem ela a chamada retorna 403) >
# copie o valor (começa com "hf_").
HF_API_TOKEN=hf_sua-chave-aqui
