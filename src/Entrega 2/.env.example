# =============================================================================
# ASA Turbo · variáveis de ambiente (docker compose, backend, scripts)
# O .env NUNCA é commitado. Aqui só nomes e exemplos, nunca valores reais.
#
#   Local:     python3 infra/local/preparar_env.py  (gera um .env completo com
#              segredos aleatórios desta máquina e a stack Supabase local)
#   Produção:  infra/deploy/.env.producao.example + infra/deploy/README.md
# =============================================================================

# --- docker compose ----------------------------------------------------------
# "local" sobe Postgres + PostgREST + GoTrue locais; "monitoring" sobe
# Prometheus + Grafana. Em produção com Supabase gerenciado: vazio ou "monitoring".
COMPOSE_PROFILES=local

# --- Web (Caddy) -------------------------------------------------------------
# ":80" = HTTP local. Um domínio (asa.exemplo.br) = HTTPS automático.
SITE_ADDRESS=:80
WEB_PORT=8080
WEB_PORT_HTTPS=8443
PUBLIC_URL=http://localhost:8080
ACME_EMAIL=equipe@example.com
# Origem extra permitida no connect-src da CSP (o Supabase gerenciado, em produção)
CSP_CONNECT_EXTRA=
# Para onde o Caddy repassa /auth/v1 (só na stack local)
SUPABASE_GW=supabase-gw:8000

# --- Supabase ----------------------------------------------------------------
# Backend -> Supabase. Local: http://supabase-gw:8000. Produção: https://SEU-PROJETO.supabase.co
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Navegador -> Supabase Auth (entra no build do front). Local: http://localhost:8080
PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave legacy service_role (eyJ...). SÓ no backend. Ignora RLS: nunca vai para o front.
SUPABASE_SERVICE_KEY=cole-a-chave-service-role-aqui
# Chave anon (pública por definição; entra no build do front)
SUPABASE_ANON_KEY=cole-a-chave-anon-aqui
# Project Settings > API > JWT Secret (valida o access_token no backend)
SUPABASE_JWT_SECRET=cole-o-jwt-secret-aqui
# Conexão Postgres direta (backup/restauração)
DATABASE_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres
# Só na stack local: senha do Postgres local
POSTGRES_PASSWORD=

# --- Embeddings (bge-m3, 1024 dimensões) --------------------------------------
# Sem nenhuma chave, o chat usa o fallback lexical local (TF-IDF).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
EMBEDDING_MODEL=@cf/baai/bge-m3
# Reserva (mesmo modelo/espaço). Opcional.
HF_API_TOKEN=
# Cache de perguntas repetidas (0 desliga)
EMBEDDING_CACHE_MAX=2000
EMBEDDING_CACHE_TTL_S=3600

# --- RAG ---------------------------------------------------------------------
CONFIDENCE_THRESHOLD=0.55
RAG_TOP_K=3
RAG_HISTORICO_MAX=6
RAG_FALLBACK_LEXICAL=true
RAG_LIMIAR_LEXICAL=0.35

# --- Modelo de risco ---------------------------------------------------------
RISK_MODEL_PATH=ml/artifacts/risco_v2.joblib
RISK_LIMIAR_AMARELO=0.30
RISK_LIMIAR_VERMELHO=0.60

# --- Aplicação ---------------------------------------------------------------
APP_ENV=producao              # local | producao (producao desliga /docs)
APP_VERSION=0.9.0
LOG_LEVEL=INFO
CORS_ORIGINS=https://asa.exemplo.br
CHAT_RATE_LIMIT_POR_MINUTO=20

# --- Backup ------------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_RETENCAO_DIAS=7

# --- Seeds de demonstração ---------------------------------------------------
DEMO_PASSWORD=defina-uma-senha-de-demo

# --- Monitoramento (profile "monitoring") ------------------------------------
GRAFANA_ADMIN_PASSWORD=defina-uma-senha
