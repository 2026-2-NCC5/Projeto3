# =============================================================================
# ASA Turbo · variáveis de ambiente (backend, scripts de ml/seeds e infra)
# Copie para ".env" nesta pasta (src/Entrega 2/.env) e preencha.
# O .env NUNCA é commitado. Aqui só nomes e exemplos, nunca valores reais.
# Variáveis do front (públicas) ficam em web/.env.example.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Project Settings > Data API (URL) e API Keys
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave legacy service_role (começa com eyJ...). SÓ no backend/scripts.
# Ignora RLS: nunca vai para o front nem para logs.
SUPABASE_SERVICE_KEY=cole-a-chave-service-role-aqui
# Chave anon (pública). O backend usa só para conferência; o front usa a dele.
SUPABASE_ANON_KEY=cole-a-chave-anon-aqui
# Project Settings > API > JWT Secret (para validar o access_token no backend)
SUPABASE_JWT_SECRET=cole-o-jwt-secret-aqui
# Conexão Postgres direta (backup/restauração com pg_dump/pg_restore)
# Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres

# --- Embeddings: Cloudflare Workers AI (@cf/baai/bge-m3, 1024 dimensões) ------
# ACCOUNT_ID: dash.cloudflare.com > a conta > ID na URL.
# API_TOKEN: My Profile > API Tokens > Custom Token > Account / Workers AI / Read.
CLOUDFLARE_ACCOUNT_ID=seu-account-id
CLOUDFLARE_API_TOKEN=seu-token
EMBEDDING_MODEL=@cf/baai/bge-m3

# --- RAG ---------------------------------------------------------------------
# Limiar de abstenção (similaridade de cosseno do melhor trecho). Ver
# web/api/perguntar.py para a medição que levou a 0.55.
CONFIDENCE_THRESHOLD=0.55
RAG_TOP_K=3
RAG_HISTORICO_MAX=6

# --- Modelo de risco ---------------------------------------------------------
RISK_MODEL_PATH=ml/artifacts/modelo_risco.joblib
RISK_MODEL_VERSION=rl-baseline-1.0
RISK_LIMIAR_AMARELO=0.30
RISK_LIMIAR_VERMELHO=0.60

# --- Aplicação ---------------------------------------------------------------
APP_ENV=local                 # local | producao
APP_VERSION=0.9.0
LOG_LEVEL=INFO
# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Limite de mensagens no chat por usuário por minuto
CHAT_RATE_LIMIT_POR_MINUTO=20

# --- Infra (VM + Caddy + backup) ---------------------------------------------
DOMAIN=asa-turbo.example.com
ACME_EMAIL=equipe@example.com
BACKUP_DIR=./backups
BACKUP_RETENCAO_DIAS=7

# --- Seeds de demonstração ---------------------------------------------------
# Senha dos 3 usuários de demo (seeds/criar_usuarios_demo.py). Ver seeds/README.md.
DEMO_PASSWORD=defina-uma-senha-de-demo
