# Copie para ".env" nesta mesma pasta e preencha. O .env nunca é commitado
# (o .gitignore da raiz já cobre). Estas variáveis são usadas pelo
# gerar_embeddings.py e precisam estar TAMBÉM no Vercel (Project Settings >
# Environment Variables) para a API em web/api/perguntar.py funcionar.

# --- Supabase ---
# Project Settings > Data API (URL) e API Keys (chave service_role)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_KEY=sua-chave-service-role-aqui

# --- Cloudflare Workers AI (embeddings, modelo @cf/baai/bge-m3) ---
# ACCOUNT_ID: dash.cloudflare.com > escolha a conta > o ID aparece na URL
#   (dash.cloudflare.com/<ACCOUNT_ID>) e na barra lateral de Workers & Pages.
# API_TOKEN: dash.cloudflare.com > My Profile > API Tokens > Create Token >
#   "Create Custom Token" > permissão: Account / Workers AI / Read.
CLOUDFLARE_ACCOUNT_ID=seu-account-id-aqui
CLOUDFLARE_API_TOKEN=seu-token-aqui

# --- Opcional ---
# Limiar de abstenção da API. Sem isso, usa o padrão definido em perguntar.py.
# CONFIDENCE_THRESHOLD=0.55
