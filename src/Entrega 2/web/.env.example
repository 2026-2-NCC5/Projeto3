# Variáveis VITE_* são PÚBLICAS: vão parar no JavaScript do navegador.
# Nunca coloque segredos aqui (a chave service_role fica só no backend).

# Modo mock: o app responde com dados fictícios fiéis a docs/api-contract.yaml e o login
# aceita os usuários de demonstração (seeds/README.md), sem backend nem Supabase.
# Padrão: true no `npm run dev`, false no build. Em dev, ?mock=0 ou ?mock=1 na URL alterna.
VITE_API_MOCK=

# Base da API FastAPI, sem barra no fim. Vazio = mesma origem (o Caddy serve app e API juntos).
# Em dev com VITE_API_MOCK=false, o vite.config.js repassa as rotas para http://localhost:8000.
VITE_API_BASE_URL=

# Supabase Auth no navegador (login por e-mail e senha). A chave anon é pública por definição;
# o acesso real é controlado pelo backend e pelo RLS.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-a-chave-anon-aqui
