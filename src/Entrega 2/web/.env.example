# Variáveis VITE_* são PÚBLICAS: vão parar no JavaScript do navegador.
# Nunca coloque segredos aqui (a chave service_role fica só no backend).

# Endereço da API. Vazio (padrão): caminho relativo /api/perguntar (em dev, o
# proxy do vite.config.js leva à produção). Em outro host: URL absoluta,
# ex. https://projeto-ia-rho.vercel.app/api/perguntar
VITE_API_URL=

# Supabase Auth no navegador (login por e-mail e senha). A chave anon é
# pública por definição; o acesso real é controlado pelo RLS e pelo backend.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-a-chave-anon-aqui
