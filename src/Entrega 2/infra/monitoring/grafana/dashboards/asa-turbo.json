  "editable": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requisições/s",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-asa"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-asa"
          },
          "expr": "sum(rate(http_requests_total{rota!=\"/health\",rota!=\"/metrics\"}[$__rate_interval]))",
          "legendFormat": "total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Latência p95 (geral)",
      "description": "",
