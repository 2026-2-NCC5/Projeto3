    {
      "id": 9,
      "type": "timeseries",
      "title": "CPU por serviço (cores)",
      "description": "cAdvisor (cgroups) + nomes do compose (job docker-nomes). 1 = um núcleo inteiro.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-asa"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-asa"
          },
          "expr": "sum by (servico) (rate(container_cpu_usage_seconds_total{id=~\"/system.slice/docker-.+[.]scope\"}[$__rate_interval]) * on (id) group_left(servico) max by (id, servico) (label_replace(up{job=\"docker-nomes\"}, \"id\", \"/system.slice/docker-$1.scope\", \"container_id\", \"(.+)\") * 0 + 1))",
          "legendFormat": "{{servico}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
