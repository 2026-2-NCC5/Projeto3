# =============================================================================
# ASA Turbo · Caddy (front estático + proxy da API)
#   SITE_ADDRESS=:80            -> local, HTTP
#   SITE_ADDRESS=asa.exemplo.br -> produção, HTTPS automático (Let's Encrypt)
# =============================================================================
{
	admin 127.0.0.1:2019
	email {$ACME_EMAIL:admin@example.com}
	servers {
		trusted_proxies static private_ranges
	}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
	# CSP estrita só para o app. O Grafana tem a própria (precisa de scripts inline).
	# 'unsafe-inline' só em style-src (React aplica style={{...}}); scripts só da origem.
	@app not path /grafana /grafana/* /prometheus /prometheus/*
	header @app Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' {$CSP_CONNECT_EXTRA}; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

	# --- Monitoramento: só com basic auth (hash bcrypt no .env, senha fora do Git).
	# Sem o profile "monitoring" no ar, estas rotas respondem 502 (atrás da senha).
	# MONITOR_HASH vazio = hash de uma senha aleatória descartada (ninguém entra).
	@monitor path /grafana /grafana/* /prometheus /prometheus/*
	basic_auth @monitor {
		{$MONITOR_USER:monitor} {$MONITOR_HASH:$2a$14$u09HigGx.Kk9C32mavOUg.r1RqgU9JK.164eulLuZeIhfwyr6hsmq}
	}
	redir /grafana /grafana/
	redir /prometheus /prometheus/
	handle /grafana/* {
		# Grafana serve em /grafana (GF_SERVER_SERVE_FROM_SUB_PATH); o login dele vem depois do basic auth
		reverse_proxy grafana:3000 {
			header_up -Authorization
		}
	}
	handle_path /prometheus/* {
		reverse_proxy prometheus:9090 {
			header_up -Authorization
		}
	}

	# API do backend: /api/chat -> backend:8000/chat
	handle_path /api/* {
		# Nenhuma rota da API precisa de mais que isso (documento: 100 mil caracteres)
		request_body {
			max_size 1MB
		}
		# /metrics fica só na rede interna (Prometheus); nunca exposto pelo proxy
		@metrics path /metrics
		respond @metrics 404
		reverse_proxy backend:8000 {
			header_up X-Request-ID {http.request.header.X-Request-ID}
		}
	}

	# Login (GoTrue) da stack local. Em produção o front fala direto com o Supabase.
	handle /auth/v1/* {
		reverse_proxy {$SUPABASE_GW:supabase-gw:8000}
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@sw path /sw.js /manifest.webmanifest /index.html /
		header @sw Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
