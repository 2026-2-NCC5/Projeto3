# ASA Turbo · backup diário (disparado por asa-backup.timer)
#   sudo systemctl start asa-backup     # roda agora
#   journalctl -u asa-backup
[Unit]
Description=ASA Turbo: backup do banco, da configuração e dos artefatos do modelo
Requires=docker.service
After=docker.service asa.service

[Service]
Type=oneshot
User=asa
Group=asa
WorkingDirectory=/opt/asa
UMask=0077
ExecStart=/opt/asa/infra/scripts/backup.sh
StandardOutput=append:/opt/asa/backups/backup.log
StandardError=append:/opt/asa/backups/backup.log
Nice=10
IOSchedulingClass=idle
